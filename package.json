{
  "name": "@inkdropapp/live-export",
  "version": "0.2.3",
  "description": "A library for programmatically exoprting notes to local filesystem from Inkdrop",
  "keywords": [
    "Inkdrop"
  ],
  "license": "MIT",
  "author": "Takuya Matsuyama <t@inkdrop.app>",
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:debug": "DEBUG=inkdrop:* vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "debug": "^4.4.3",
    "inkdrop-model": "^3.0.0",
    "js-yaml": "^5.4.2",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@11.24.0"
}
